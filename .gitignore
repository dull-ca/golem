# ---> Rust
# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# devenv
.devenv*
devenv.local.nix
.direnv

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# Smoke-test artifacts. run.sh creates these in-tree on every invocation;
# operator.sk is a private ed25519 key, signed-*.json are signed bundles.
# Keep them out of commits even if their lifetime is "test only."
smoke-test/operator.sk
smoke-test/operator.pk
smoke-test/signed-*.json

# docs site (Astro Starlight)
sites/website/node_modules
sites/website/dist
sites/website/.astro
sites/website/bun.lockb

# fleet test-harness runtime dir (ephemeral VMs, images, keys)
/.fleet/
apps/fleet/__pycache__/

# secretspec dotenv provider files. These hold resolved secret values in
# plaintext next to the secretspec.toml that declares them (ADR 0047).
.env
.env.*
!.env.example

__pycache__/
*.pyc

# nix build output symlink
result
result-*

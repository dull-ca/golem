[Unit]
Description=Golem bookkeeping agent
Documentation=https://codeberg.org/dull/golem
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/golemd \
    --state-dir /var/lib/golem \
    --node %H \
    --listen 127.0.0.1:7474
Restart=on-failure
RestartSec=5s

# The agent only reads/writes its own state dir and binds a localhost
# port. Sandbox aggressively.
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
LockPersonality=true

StateDirectory=golem
StateDirectoryMode=0700
ReadWritePaths=/var/lib/golem

[Install]
WantedBy=multi-user.target

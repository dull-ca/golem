# Serves the pre-built static Starlight site (flake.nix packages `dist/` under
# /var/www/html). Plain HTTP on :80 behind an external TLS terminator, so Caddy
# does no cert management of its own: `auto_https off` (no ACME, no HTTP->HTTPS
# redirect) and `admin off` (no local admin API / config endpoint).
{
	admin off
	auto_https off
	persist_config off
}

:80 {
	root * /var/www/html
	encode gzip zstd
	file_server

	# Starlight emits a static 404.html; serve it for any missing path so
	# unknown URLs get the styled not-found page rather than Caddy's bare 404.
	handle_errors {
		@404 expression {http.error.status_code} == 404
		rewrite @404 /404.html
		file_server
	}
}

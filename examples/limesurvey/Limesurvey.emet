module Limesurvey exposing
  ( LimeConfig(..)
  , LimeSurvey(..)
  , LimeSurveyDatabase(..)
  , defaults
  , limesurvey
  , limesurveyDatabase
  , config
  , route
  , workload
  , units
  )

import Quadlet exposing
  ( Image
  , image
  , env
  , Network(..)
  , Restart(..)
  , Access(..)
  , Relabel(..)
  , fromVolume
  , fromHost
  , Expose(..)
  , Workload(..)
  , workloadGlyphs
  )
import Routing exposing (Route)
import Routing as R

type LimeSurveyDatabase = LimeSurveyDatabase
  { image     : Image
  , container : String
  , name      : String
  , volume    : String
  , password  : String
  }

type LimeSurvey = LimeSurvey
  { image              : Image
  , container          : String
  , port               : Int
  , administrator      : String
  , administratorUser  : String
  , administratorEmail : String
  , password           : String
  , pluginsPath        : String
  , uploadPath         : String
  }

type LimeConfig = LimeConfig
  { domain     : String
  , network    : Network
  , survey     : LimeSurvey
  , database   : LimeSurveyDatabase
  }

defaults :
  { database : { image : Image, container : String, name : String, volume : String }
  , survey : { image : Image, container : String, port : Int, administrator : String, administratorUser : String, pluginsPath : String, uploadPath : String }
  }
defaults =
  { database =
      { image = image "docker.io/library" "mariadb" "11.4"
      , container = "mysql"
      , name = "limesurvey"
      , volume = "limesurvey-db-data"
      }
  , survey =
      { image = image "docker.io" "adamzammit/limesurvey" "7.0.7"
      , container = "limesurvey"
      , port = 80
      , administrator = "Lime Administrator"
      , administratorUser = "admin"
      , pluginsPath = "/data/limesurvey/plugins"
      , uploadPath = "/data/limesurvey/upload"
      }
  }

limesurveyDatabase :
  { image : Image, container : String, name : String, volume : String }
  -> { password : String }
  -> LimeSurveyDatabase
limesurveyDatabase defaults required =
  LimeSurveyDatabase
    { image = defaults.image
    , container = defaults.container
    , name = defaults.name
    , volume = defaults.volume
    , password = required.password
    }


limesurvey :
  { image             : Image
  , container         : String
  , port              : Int
  , administrator     : String
  , administratorUser : String
  , pluginsPath       : String
  , uploadPath        : String
  }
  -> { administratorEmail : String, password : String }
  -> LimeSurvey
limesurvey defaults required =
  LimeSurvey
    { image = defaults.image
    , container = defaults.container
    , port = defaults.port
    , administrator = defaults.administrator
    , administratorUser = defaults.administratorUser
    , administratorEmail = required.administratorEmail
    , password = required.password
    , pluginsPath = defaults.pluginsPath
    , uploadPath = defaults.uploadPath
    }

config :
  { domain     : String
  , network    : Network
  , survey     : LimeSurvey
  , database   : LimeSurveyDatabase
  }
  -> LimeConfig
config required =
  LimeConfig
    { domain = required.domain
    , network = required.network
    , survey = required.survey
    , database = required.database
    }

route : LimeConfig -> Route
route (LimeConfig spec) =
  case spec.survey of
    LimeSurvey app ->
      R.route app.container spec.domain app.port

workload : LimeConfig -> Workload
workload (LimeConfig spec) =
  case spec.survey of
    LimeSurvey app ->
      case spec.database of
        LimeSurveyDatabase db ->
          Workload
            { name = app.container
            , image = app.image
            , env =
                [ env "LIMESURVEY_DB_HOST" db.container
                , env "LIMESURVEY_DB_NAME" db.name
                , env "LIMESURVEY_DB_PASSWORD" db.password
                , env "LIMESURVEY_ADMIN_USER" app.administratorUser
                , env "LIMESURVEY_ADMIN_PASSWORD" app.password
                , env "LIMESURVEY_ADMIN_NAME" app.administrator
                , env "LIMESURVEY_ADMIN_EMAIL" app.administratorEmail
                ]
            , envFiles = []
            , labels = []
            , ports = []
            , networks = [ spec.network ]
            , volumes =
                [ fromHost app.pluginsPath "/var/www/html/plugins" ReadWrite NoRelabel
                , fromHost app.uploadPath "/var/www/html/upload" ReadWrite NoRelabel
                ]
            , restart = Always
            , expose = Unexposed
            }

databaseWorkload : LimeConfig -> Workload
databaseWorkload (LimeConfig spec) =
  case spec.database of
    LimeSurveyDatabase db ->
      Workload
        { name = db.container
        , image = db.image
        , env =
            [ env "MARIADB_ROOT_PASSWORD" db.password
            , env "MARIADB_DATABASE" db.name
            ]
        , envFiles = []
        , labels = []
        , ports = []
        , networks = [ spec.network ]
        , volumes =
            [ fromVolume db.volume "/var/lib/mysql" ReadWrite Private ]
        , restart = Always
        , expose = Unexposed
        }

units : LimeConfig -> Workload -> List Scroll
units c published =
  case c of
    LimeConfig spec ->
      case spec.database of
        LimeSurveyDatabase db ->
          case spec.survey of
            LimeSurvey app ->
              [ scroll { name = db.container, glyphs = workloadGlyphs (databaseWorkload c) }
              , scroll { name = app.container, glyphs = workloadGlyphs published }
              ]

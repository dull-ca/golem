module Main exposing (..)

import Ingress
import Limesurvey
import Quadlet exposing (Network(..))

survey =
  Limesurvey.config
    { domain = "survey.lichess.app"
    , network = ManagedNetwork "limesurvey"
    , survey =
        Limesurvey.limesurvey Limesurvey.defaults.survey
          { administratorEmail = "bigbeards@lichess.org"
          , password = Secretspec.get "LIMESURVEY_ADMIN_PASSWORD"
          }
    , database =
        Limesurvey.limesurveyDatabase Limesurvey.defaults.database
          { password = Secretspec.get "LIMESURVEY_DB_PASSWORD" }
    }

deployment : String -> Scroll
deployment name =
  let
    published =
      Ingress.publish (Limesurvey.route survey) (Limesurvey.workload survey)
  in
  scroll
    { name = name
    , groups = List.concat [ Ingress.units, Limesurvey.units survey published ]
    }

main : List Scroll
main = [ deployment "manta" ]

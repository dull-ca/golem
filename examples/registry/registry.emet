module Main exposing (..)

import Quadlet exposing
  ( image
  , tcp
  , Restart(..)
  , Access(..)
  , Relabel(..)
  , fromVolume
  , Expose(..)
  , Workload(..)
  , workloadGlyphs
  )

registry : Workload
registry =
  Workload
    { name = "registry"
    , image = image "docker.io/library" "registry" "2"
    , env = []
    , ports = [ tcp 5000 5000 ]
    , volumes =
        [ fromVolume "golem-registry-data" "/var/lib/registry" ReadWrite Private ]
    , restart = Always
    , expose = Internal
    }

main : List Scroll
main = [ scroll { name = "registry", glyphs = workloadGlyphs registry } ]

module Main exposing (..)

registryName : String
registryName = "registry"

registryImage : String
registryImage = "docker.io/library/registry:2"

publishedPort : Int
publishedPort = 5000

storeVolume : String
storeVolume = "golem-registry-data"

quadletPath : String
quadletPath = "/etc/containers/systemd/${registryName}.container"

serviceUnit : String
serviceUnit = "${registryName}.service"

quadletContents : String
quadletContents =
  String.join "\n"
    [ "[Unit]"
    , "Description=Golem container registry: ${registryName}"
    , ""
    , "[Container]"
    , "Image=${registryImage}"
    , "ContainerName=${registryName}"
    , "PublishPort=${String.fromInt publishedPort}:5000"
    , "Volume=${storeVolume}:/var/lib/registry:Z"
    , ""
    , "[Service]"
    , "Restart=always"
    , ""
    , "[Install]"
    , "WantedBy=multi-user.target default.target"
    ]

registryGlyphs : List Glyph
registryGlyphs =
  [ aptPackage { name = "podman" }
  , file
      { path = quadletPath
      , contents = quadletContents
      , mode = "0644"
      }
  , systemdService { unit = serviceUnit }
  ]

registry : Scroll
registry = scroll { name = registryName, glyphs = registryGlyphs }

main : List Scroll
main = [ registry ]

-- The lichess fleet: the entry module. Each `Scroll` is one host's inventory,
-- built by mapping the `Lichess` helpers over that host's workloads, services,
-- and ingresses; `main` lists all six hosts, so compiling this file emits a
-- manifest of six scrolls — golemd on each host selects and enacts only its own.
--
-- Per-host inventory:
--   scaly — one fishnet workload (chess-analysis worker, no inbound port).
--   manta — the leroyjenkins edge workloads, the lila app + redis services,
--           and the public lichess.org / lichess1.org ingresses.
--   orbit — the lila-* microservices (http, engine, gif, fishnet, ip2proxy,
--           push) plus their public ingresses.
--   talos — a fishnet worker, the monitoring/infra services (influx, prometheus,
--           alertmanager, loki, dns, ntp, syslog), and their ingresses.
--   kaiju — the primary mongod service.
--   zulip — the zulip stack (app, email, postgres, redis) and its ingress.
--
-- `Lichess` and `Fleet` sit in this directory and win on entry-directory-first
-- precedence, shadowing `lib/Fleet.emet`. The repo-root `emet.json` search path
-- supplies `Nftables` and `Quadlet`, which `Lichess` imports (ADR 0024).
--
-- This fleet is an illustrative topology, not a deployable one: some image
-- refs (leroyjenkins, lila-ip2proxy, lila:latest) are not publicly pullable,
-- so hosts carrying them are not meant for live apply. scaly and talos, both
-- on the public `niklasf/fishnet` image, are the live-tested hosts; on talos,
-- dns publishes on 5353 because systemd-resolved owns 53 on the guests.
module Main exposing (..)

import Lichess exposing
  ( dockerImage
  , ghcrImage
  , workload
  , service
  , ingress
  , host
  )

scaly : Scroll
scaly = host "scaly" (workload "fishnet" (dockerImage "niklasf/fishnet" "latest"))

manta : Scroll
manta =
  scroll
    { name = "manta"
    , notifies = [ "golem-nftables.service" ]
    , glyphs =
        List.concat
          [ workload "leroyjenkins-lila" (ghcrImage "lichess-org/leroyjenkins" "latest")
          , workload "leroyjenkins-nginx" (ghcrImage "lichess-org/leroyjenkins" "latest")
          , service "lila" (ghcrImage "lichess-org/lila" "latest") 9663
          , service "redis-server" (dockerImage "redis" "7") 6379
          , ingress "lichess.org" "lila" 443
          , ingress "lichess1.org" "lila" 443
          ]
    }

orbit : Scroll
orbit =
  scroll
    { name = "orbit"
    , notifies = [ "golem-nftables.service" ]
    , glyphs =
        List.concat
          [ service "lila-http" (ghcrImage "lichess-org/lila-http" "latest") 9080
          , service "lila-engine" (ghcrImage "lichess-org/lila-engine" "latest") 9666
          , service "lila-gif" (ghcrImage "lichess-org/lila-gif" "latest") 6175
          , service "lila-fishnet" (ghcrImage "lichess-org/lila-fishnet" "latest") 9665
          , service "lila-ip2proxy" (ghcrImage "lichess-org/lila-ip2proxy" "latest") 1929
          , service "lila-push" (ghcrImage "lichess-org/lila-push" "latest") 9054
          , ingress "http.lichess.org" "lila-http" 443
          , ingress "engine.lichess.ovh" "lila-engine" 443
          ]
    }

talos : Scroll
talos =
  scroll
    { name = "talos"
    , notifies = [ "golem-nftables.service" ]
    , glyphs =
        List.concat
          [ workload "fishnet" (dockerImage "niklasf/fishnet" "latest")
          , service "influxd" (dockerImage "influxdb" "2") 8086
          , service "alertmanager" (dockerImage "prom/alertmanager" "latest") 9093
          , service "prometheus" (dockerImage "prom/prometheus" "latest") 9090
          , service "loki" (dockerImage "grafana/loki" "latest") 3100
          , service "dns" (dockerImage "dockurr/dnsmasq" "latest") 5353
          , service "ntpd" (dockerImage "cturra/ntp" "latest") 123
          , service "rsyslogd" (dockerImage "rsyslog/rsyslog" "latest") 514
          , ingress "monitor.lichess.ovh" "prometheus" 443
          , ingress "prom.lichess.ovh" "prometheus" 443
          , ingress "alertmanager.lichess.ovh" "alertmanager" 443
          ]
    }

kaiju : Scroll
kaiju =
  scroll
    { name = "kaiju"
    , notifies = [ "golem-nftables.service" ]
    , glyphs = service "mongod-lichess-primary" (dockerImage "mongo" "7") 27017
    }

zulip : Scroll
zulip =
  scroll
    { name = "zulip"
    , notifies = [ "golem-nftables.service" ]
    , glyphs =
        List.concat
          [ service "zulip" (dockerImage "zulip/docker-zulip" "latest") 80
          , service "zulip-email" (dockerImage "zulip/docker-zulip" "latest") 25
          , service "postgresql" (dockerImage "zulip/zulip-postgresql" "14") 5432
          , service "redis" (dockerImage "redis" "7") 6379
          , ingress "hq.lichess.ovh" "zulip" 443
          ]
    }

main : List Scroll
main = [ scaly, manta, orbit, talos, kaiju, zulip ]

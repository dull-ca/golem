-- The lichess fleet's own ergonomic helpers (ADR 0023 layer c): user Emet built
-- on the shipped `Quadlet` library, not part of it. `dockerImage`/`workload`/
-- `service` are thin shortcuts over `Workload` for this fleet's common shapes —
-- a docker.io image, a no-ingress workload, an internally-exposed service.
--
-- `ingress` stays hand-rolled nginx (its own `aptPackage`/`file`/
-- `systemdService` glyphs) because a reverse proxy is a *different* container's
-- config, not a property of the upstream workload — so it is not a quadlet
-- `Workload` and does not go through the library (ADR 0023 §7).
module Lichess exposing
  ( dockerImage
  , ghcrImage
  , workload
  , service
  , ingress
  , host
  )

import Fleet exposing (internalNetwork)
import Nftables exposing (nftablesBase, nftablesDropIn)
import Quadlet exposing
  ( Image
  , image
  , tcp
  , Restart(..)
  , Expose(..)
  , Workload(..)
  , workloadGlyphs
  )

dockerImage : String -> String -> Image
dockerImage name tag = image "docker.io" name tag

ghcrImage : String -> String -> Image
ghcrImage name tag = image "ghcr.io" name tag

workload : String -> Image -> List Glyph
workload name img =
  workloadGlyphs
    (Workload
      { name = name
      , image = img
      , env = []
      , envFiles = []
      , labels = []
      , ports = []
      , networks = []
      , volumes = []
      , restart = Always
      , expose = Unexposed
      })

-- The workload, then the firewall. `nftablesBase` precedes the drop-in because
-- it carries the `/etc/nftables.d` directory glyph and source order is enact
-- order (ADR 0031); the rule itself is internal-only, so the port is reachable
-- from `Fleet.internalNetwork` and nowhere else.
service : String -> Image -> Int -> List Glyph
service name img port =
  List.concat
    [ workloadGlyphs
        (Workload
          { name = name
          , image = img
          , env = []
          , envFiles = []
          , labels = []
          , ports = [ tcp port port ]
          , networks = []
          , volumes = []
          , restart = Always
          , expose = Unexposed
          })
    , nftablesBase
    , [ nftablesDropIn "${name}-${String.fromInt port}" [ internalAcceptRule name port ] ]
    ]

nginxSitePath : String -> String
nginxSitePath name = "/etc/nginx/sites-enabled/${name}.conf"

nginxSite : String -> String -> String
nginxSite name upstream =
  String.join "\n"
    [ "upstream ${upstream}_backend {"
    , "  server ${upstream}.internal;"
    , "}"
    , ""
    , "server {"
    , "  listen 443 ssl http2;"
    , "  server_name ${name};"
    , ""
    , "  ssl_certificate /etc/letsencrypt/live/${name}/fullchain.pem;"
    , "  ssl_certificate_key /etc/letsencrypt/live/${name}/privkey.pem;"
    , ""
    , "  location / {"
    , "    proxy_pass http://${upstream}_backend;"
    , "    proxy_set_header Host $host;"
    , "    proxy_set_header X-Real-IP $remote_addr;"
    , "    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;"
    , "    proxy_set_header X-Forwarded-Proto $scheme;"
    , "  }"
    , "}"
    ]

publicAcceptRule : String -> Int -> String
publicAcceptRule name port =
  "tcp dport ${String.fromInt port} accept comment \"ingress ${name}\""

internalAcceptRule : String -> Int -> String
internalAcceptRule name port =
  "tcp dport ${String.fromInt port} ip saddr ${internalNetwork} accept comment \"${name}\""

-- nginx plus the one public opening in front of it. `nftablesBase` leads for the
-- same reason it does in `service` — the drop-in it writes needs
-- `/etc/nftables.d` to exist first, and nothing but source order sequences them.
-- Two ingresses on 443 write two accept rules; nftables' first-match makes the
-- second redundant rather than a conflict (ADR 0041).
ingress : String -> String -> Int -> List Glyph
ingress name upstream port =
  List.concat
    [ nftablesBase
    , [ aptPackage { name = "nginx" }
      , file
          { path = nginxSitePath name
          , contents = nginxSite name upstream
          , mode = "0644"
          }
      , nftablesDropIn "ingress-${name}" [ publicAcceptRule name port ]
      , systemdService { unit = "nginx.service" }
      ]
    ]

-- One host as a flat leaf scroll. No `notifies`, so it suits a host that opens
-- no ports; a host carrying `service` or `ingress` glyphs writes its own
-- `scroll` with `notifies = [ "golem-nftables.service" ]` so the drop-ins it
-- adds are actually loaded (ADR 0036) — see `fleet.emet`.
host : String -> List Glyph -> Scroll
host name glyphs = scroll { name = name, glyphs = glyphs }

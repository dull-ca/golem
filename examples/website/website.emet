-- The serving box of the self-hosted-CI loop (milestone 3): golem provisions
-- `remora`, the machine that serves the website image `talos` pushed. It drops
-- in the insecure-registry fragment marking golem's registry at 10.0.2.2:5000
-- over plain HTTP, then runs one public `Workload` — the golem-website container
-- pulled from that registry, published on :80 from the :8080 its nginx serves
-- (docs/adr/0052-nginx-static-docs-image.md). Together with `kaiju` and
-- `talos` this closes the loop: build and push on one golem-managed box,
-- store on another, pull and serve on a third, all fed by golem's own registry.
--
-- Authored against the shared `Quadlet` library, resolved from `lib/` via the
-- repo-root `emet.json` (ADR 0024).
module Main exposing (..)

import Quadlet exposing
  ( image
  , tcp
  , Restart(..)
  , Expose(..)
  , Workload(..)
  , workloadGlyphs
  )

registryEndpoint : String
registryEndpoint = "10.0.2.2:5000"

insecureConfPath : String
insecureConfPath = "/etc/containers/registries.conf.d/golem-registry.conf"

insecureConfContents : String
insecureConfContents =
  String.join "\n"
    [ "[[registry]]"
    , "location = \"${registryEndpoint}\""
    , "insecure = true"
    , ""
    ]

website : Workload
website =
  Workload
    { name = "golem-website"
    , image = image registryEndpoint "golem-website" "latest"
    , env = []
    , envFiles = []
    , labels = []
    , ports = [ tcp 80 8080 ]
    , networks = []
    , volumes = []
    , restart = Always
    , expose = Public
    }

websiteGlyphs : List Glyph
websiteGlyphs =
  List.concat
    [ [ file
          { path = insecureConfPath
          , contents = insecureConfContents
          , mode = "0644"
          }
      ]
    , workloadGlyphs website
    ]

main : List Scroll
main =
  [ scroll
      { name = "remora"
      , notifies = [ "golem-nftables.service" ]
      , glyphs = websiteGlyphs
      }
  ]

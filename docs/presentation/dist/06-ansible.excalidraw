      "versionNonce": 1471558690,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1735689600000,
      "link": null,
      "locked": false,
      "text": "Layer 3 was mostly manual: DNS entries, proxy configuration and load balancer members were edited by hand. Layers 5 and 6 were manual outright — a human\nchose the host, a human ran the change, and all five parts of orchestration lived in someone's head.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Layer 3 was mostly manual: DNS entries, proxy configuration and load balancer members were edited by hand. Layers 5 and 6 were manual outright — a human\nchose the host, a human ran the change, and all five parts of orchestration lived in someone's head.",
      "lineHeight": 1.25,
      "autoResize": true
    }

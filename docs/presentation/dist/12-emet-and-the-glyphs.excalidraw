    {
      "id": "c76d00be1c5723db5592e828",
      "type": "text",
      "x": 105.3,
      "y": 566.0,
      "width": 365.4,
      "height": 56.25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],

      "roundness": null,
      "seed": 1401056307,
      "version": 1,
      "versionNonce": 1416629484,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1735689600000,
      "link": null,
      "locked": false,
      "text": "Richer shapes — workloads, quadlets, ingress —\nare Emet library abstractions that compile down\nto these four. golemd never grows a fifth kind.",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "277c3bfabce5e99b12c6db17",
      "originalText": "Richer shapes — workloads, quadlets, ingress —\nare Emet library abstractions that compile down\nto these four. golemd never grows a fifth kind.",
      "lineHeight": 1.25,
      "autoResize": false
    },
    {

    {
      "id": "026b54149a896f2eb281e9b9",
      "type": "text",
      "x": 64.0,
      "y": 452.0,
      "width": 448.0,
      "height": 80.0,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,

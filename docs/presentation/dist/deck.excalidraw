    {
      "id": "4d3d7022db4a0d849de04e65",
      "type": "text",
      "x": 64.0,
      "y": 4330.0,
      "width": 1472.0,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",

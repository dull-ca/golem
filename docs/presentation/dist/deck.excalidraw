      "isDeleted": false,
      "boundElements": [],
      "updated": 1735689600000,
      "link": null,
      "locked": false,
      "text": "hosted — yours, but on their terms",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "hosted — yours, but on their terms",
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "9db19cb2cd851965a1927e3e",
      "type": "text",
      "x": 64.0,
      "y": 780.0,
      "width": 1472.0,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "8a101659a4c3a748e62123c5",
      "roundness": null,
      "seed": 925172396,
      "version": 1,
      "versionNonce": 1638723090,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1735689600000,
      "link": null,
      "locked": false,
      "text": "Left to right: the less you own, the less you control. Nothing here is free — what you stop operating, you start depending on.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Left to right: the less you own, the less you control. Nothing here is free — what you stop operating, you start depending on.",
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "8b855d1b5abae54ace95615c",
      "type": "frame",
      "x": 1760.0,

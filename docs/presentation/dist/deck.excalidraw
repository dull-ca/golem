    {
      "id": "026b54149a896f2eb281e9b9",
      "type": "text",
      "x": 3584.0,
      "y": 3932.0,
      "width": 448.0,
      "height": 80.0,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "d5974470b46d6aedf81edf40",
      "roundness": null,
      "seed": 99385809,
      "version": 1,
      "versionNonce": 1202942000,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1735689600000,
      "link": null,
      "locked": false,
      "text": "Each level holds either glyphs or named\nsub-scrolls — never both. A leaf unit is the\nfailure-isolation boundary: one unit's failure\nnever rolls back a sibling.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Each level holds either glyphs or named\nsub-scrolls — never both. A leaf unit is the\nfailure-isolation boundary: one unit's failure\nnever rolls back a sibling.",
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "277c3bfabce5e99b12c6db17",

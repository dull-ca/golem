    {
      "id": "c76d00be1c5723db5592e828",
      "type": "text",
      "x": 3625.3,
      "y": 4046.0,
      "width": 365.4,
      "height": 56.25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "d5974470b46d6aedf81edf40",
      "roundness": null,
      "seed": 1401056307,
      "version": 1,
      "versionNonce": 1416629484,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1735689600000,
      "link": null,
      "locked": false,
      "text": "Richer shapes — workloads, quadlets, ingress —\nare Emet library abstractions that compile down\nto these four. golemd never grows a fifth kind.",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "277c3bfabce5e99b12c6db17",
      "originalText": "Richer shapes — workloads, quadlets, ingress —\nare Emet library abstractions that compile down\nto these four. golemd never grows a fifth kind.",
      "lineHeight": 1.25,
      "autoResize": false
    },
    {
      "id": "73cb10613d46ed6871baff32",
      "type": "rectangle",

      "link": null,
      "locked": false,
      "name": "02 · What you configure"
    },
    {
      "id": "045067395f7484ffcc2332ad",
      "type": "text",
      "x": 1824.0,
      "y": 64.0,
      "width": 1472.0,
      "height": 42.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],

    {
      "id": "4d9963b635c57d974c14047b",
      "type": "text",
      "x": 703.3,
      "y": 727.62,
      "width": 257.7,
      "height": 18.75,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",

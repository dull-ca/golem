      "seed": 1878996914,
      "version": 1,
      "versionNonce": 354225930,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1735689600000,
      "link": null,
      "locked": false,
      "text": "The ladder of what you configure",
      "fontSize": 34,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The ladder of what you configure",
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "058cd4c3d9e0531d10c61299",
      "type": "text",
      "x": 1824.0,
      "y": 116.5,
      "width": 1472.0,
      "height": 22.5,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "8b855d1b5abae54ace95615c",
      "roundness": null,
      "seed": 544952446,
      "version": 1,
      "versionNonce": 711354811,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1735689600000,
      "link": null,
      "locked": false,
      "text": "Same shape, different question: not what you buy, what you still have to answer.",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Same shape, different question: not what you buy, what you still have to answer.",
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "3aca831cfd5b69465157d3e9",
      "type": "text",
      "x": 1824.0,
      "y": 150.0,
      "width": 1472.0,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "8b855d1b5abae54ace95615c",
      "roundness": null,
      "seed": 369207298,
      "version": 1,
      "versionNonce": 982991968,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1735689600000,
      "link": null,
      "locked": false,
      "text": "Past the middle you stop thinking in machines and start thinking in resources.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Past the middle you stop thinking in machines and start thinking in resources.",
      "lineHeight": 1.25,
      "autoResize": true
    },

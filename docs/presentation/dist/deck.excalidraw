      "roundness": null,
      "seed": 177611561,
      "version": 1,
      "versionNonce": 591205603,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1735689600000,
      "link": null,
      "locked": false,
      "text": "None of this is new orchestration. It is the same work, written down as state instead of as steps — and reversible when it is wrong.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "None of this is new orchestration. It is the same work, written down as state instead of as steps — and reversible when it is wrong.",
      "lineHeight": 1.25,
      "autoResize": true
    },

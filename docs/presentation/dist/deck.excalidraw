      "roundness": null,
      "seed": 166583914,
      "version": 1,
      "versionNonce": 1647157426,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1735689600000,
      "link": null,
      "locked": false,
      "text": "The four require systemd. They do not assume\nquadlets — an older or different machine can be\ngiven another approach.",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "73cb10613d46ed6871baff32",
      "originalText": "The four require systemd. They do not assume\nquadlets — an older or different machine can be\ngiven another approach.",
      "lineHeight": 1.25,
      "autoResize": false
    },

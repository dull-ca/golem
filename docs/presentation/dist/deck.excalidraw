      "boundElements": [],
      "updated": 1735689600000,
      "link": null,
      "locked": false,
      "text": "Layer 6 is drawn as a column, not a band, because orchestration acts across layers 2 to 5 rather than sitting on top of them. Layer 1 is underneath all of it.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Layer 6 is drawn as a column, not a band, because orchestration acts across layers 2 to 5 rather than sitting on top of them. Layer 1 is underneath all of it.",
      "lineHeight": 1.25,
      "autoResize": true
    },

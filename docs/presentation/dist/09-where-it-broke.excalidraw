      "boundElements": [],
      "updated": 1735689600000,
      "link": null,
      "locked": false,
      "text": "the dry run collapses — a task that edits a file an earlier task created fails the whole run\nso you end up putting the change on a live host and finding the runtime errors there",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "the dry run collapses — a task that edits a file an earlier task created fails the whole run\nso you end up putting the change on a live host and finding the runtime errors there",
      "lineHeight": 1.25,
      "autoResize": true
    },

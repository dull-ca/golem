-- The shipped, strongly-typed Podman-Quadlet library (ADR 0023 layer b):
-- Debian + systemd + Podman specific, and lowering entirely to the four glyphs.
-- It models the two quadlet unit kinds golem actually writes — a `.container`
-- and the separate `.volume` unit it references by a mount line — so the types
-- mirror the files on disk rather than an invented middle layer.
--
-- `Mount` is a sum because a named-volume mount and a host-path mount are
-- genuinely different: `FromVolume` names a `.volume` unit and emits no
-- directory; `FromHost` names a host path and emits a `directory` glyph source
-- (ADR 0019) so the bind-mount source exists before the unit starts.
--
-- Three ways to name an image. `image registry name tag` and `imageAt registry
-- name digest` take the parts explicitly. `imageRef` takes one Docker reference
-- string (`"ghcr.io/dull/golem:v1"`) and splits it structurally — the ADR 0023
-- §1 single-string constructor, unblocked now that `String.split` exists
-- (ADR 0025).
--
-- Lowering: a `Workload` becomes a `ContainerUnit` plus the `VolumeUnit`s its
-- `FromVolume` mounts reference (`workloadUnit`/`derivedVolumeUnits`), and those
-- lower to glyphs (`containerUnitGlyphs`/`volumeUnitGlyphs`).
module Quadlet exposing
  ( Ref(..)
  , Image(..)
  , image
  , imageAt
  , imageRef
  , Proto(..)
  , Port(..)
  , tcp
  , udp
  , EnvVar(..)
  , env
  , Label(..)
  , label
  , Network(..)
  , NetworkUnit(..)
  , networkUnit
  , derivedNetworkUnits
  , networkUnitGlyphs
  , Restart(..)
  , Access(..)
  , Relabel(..)
  , Mount(..)
  , fromVolume
  , fromHost
  , VolumeUnit(..)
  , volumeUnit
  , ContainerUnit(..)
  , Expose(..)
  , Workload(..)
  , derivedVolumeUnits
  , volumeUnitGlyphs
  , containerUnitGlyphs
  , workloadUnit
  , workloadGlyphs
  )

import Fleet exposing (internalNetwork)
import Nftables exposing (nftablesBase, nftablesDropIn)

-- How an image pins its content: a mutable `Tag`, or an immutable `Digest`.
-- `imageLine` renders the two with different separators — `name:tag` against
-- `name@digest`.
type Ref
  = Tag String
  | Digest String

-- A fully-qualified image: the registry to pull from, the repository name, and
-- the `Ref` that pins it. Built by `image`, `imageAt`, or `imageRef`; it reaches
-- the container unit as the `Image=` line.
type Image = Image
  { registry : String
  , name     : String
  , ref      : Ref
  }

-- An image from its three parts, pinned by tag —
-- `image "docker.io" "niklasf/fishnet" "latest"`. Nothing is defaulted; for the
-- one-string spelling with defaults, use `imageRef`.
image : String -> String -> String -> Image
image registry name tag =
  Image { registry = registry, name = name, ref = Tag tag }

-- `image`'s immutable sibling: the same three parts, pinned by digest, so the
-- workload keeps running the exact bytes it was deployed with.
imageAt : String -> String -> String -> Image
imageAt registry name digest =
  Image { registry = registry, name = name, ref = Digest digest }

-- Renders the `Image=` line value from an `Image` — `registry/name:tag` or
-- `registry/name@digest`. Named `imageRef` until the single-string parser took
-- that name (Emet has no overloading).
imageLine : Image -> String
imageLine img =
  case img of
    Image spec ->
      case spec.ref of
        Tag t -> "${spec.registry}/${spec.name}:${t}"
        Digest d -> "${spec.registry}/${spec.name}@${d}"

defaultRegistry : String
defaultRegistry = "docker.io"

looksLikeRegistry : String -> Bool
looksLikeRegistry segment =
  String.contains "." segment
    || String.contains ":" segment
    || segment == "localhost"

absent : Int
absent = 0 - 1

firstIndex : String -> String -> Int
firstIndex needle haystack =
  List.foldl (\i seen -> if seen < 0 then i else seen) absent (String.indexes needle haystack)

lastIndex : String -> String -> Int
lastIndex needle haystack =
  List.foldl (\i _ -> i) absent (String.indexes needle haystack)

splitRegistry : String -> { registry : String, path : String }
splitRegistry reference =
  let
    slash = firstIndex "/" reference
    head = String.left slash reference
    rest = String.dropLeft (slash + 1) reference
    hasRegistry = slash >= 0 && looksLikeRegistry head
  in
    if hasRegistry then
      { registry = head, path = rest }
    else
      { registry = defaultRegistry, path = reference }

splitTag : String -> { name : String, tag : String }
splitTag path =
  let
    lastSlash = lastIndex "/" path
    colon = lastIndex ":" path
    hasTag = colon > lastSlash
  in
    if hasTag then
      { name = String.left colon path, tag = String.dropLeft (colon + 1) path }
    else
      { name = path, tag = "latest" }

-- The digest arm of `imageRef`: the text before the `@` split into registry and
-- name, the text after taken as the digest verbatim. Split out as its own
-- function because its `let … in` cannot nest inside a `case` arm, so the
-- digest-vs-tag choice in `imageRef` is a top-level `if`, not a `case` with
-- `let`s in its arms (docs/TODO.md, A. Emet language backlog).
imageRefDigest : String -> String -> Image
imageRefDigest beforeDigest digest =
  let
    parts = splitRegistry beforeDigest
  in
    Image { registry = parts.registry, name = parts.path, ref = Digest digest }

-- The tag arm of `imageRef` (no `@` in the reference): split off any registry,
-- then read a `:tag` after the last `/`, defaulting to `latest`. A sibling of
-- `imageRefDigest` for the same `case`-arm `let` reason noted there.
imageRefTagged : String -> Image
imageRefTagged reference =
  let
    parts = splitRegistry reference
    tagged = splitTag parts.path
  in
    Image { registry = parts.registry, name = tagged.name, ref = Tag tagged.tag }

-- Parses one Docker reference string into an `Image`, structurally and without
-- touching the network. The rules:
--   * a digest is everything after the first `@`;
--   * the leading `/`-segment is a registry only if it looks like one — it
--     contains `.` or `:`, or equals `localhost` — otherwise there is no
--     explicit registry and `registry` defaults to `docker.io`;
--   * a `:` after the last `/` is the tag; with none, the tag defaults to
--     `latest`.
-- Total: it never validates against a registry and never fails. Odd input
-- degrades to these defaults rather than crashing — `imageRef "registry"` is
-- `docker.io/registry:latest`, not an error.
imageRef : String -> Image
imageRef reference =
  let
    at = firstIndex "@" reference
  in
    if at >= 0 then
      imageRefDigest (String.left at reference) (String.dropLeft (at + 1) reference)
    else
      imageRefTagged reference

-- The transport of a published port. The two differ only in the `/tcp` or
-- `/udp` suffix on the unit's `PublishPort=` line.
type Proto = TCP | UDP

-- One published port: `host` is the port on the machine, `container` the port
-- inside it. Built by `tcp`/`udp`. Only `host` reaches the firewall rules
-- `Expose` generates.
type Port = Port { host : Int, container : Int, proto : Proto }

-- `tcp host container` — publish a TCP port, machine side first.
tcp : Int -> Int -> Port
tcp host container = Port { host = host, container = container, proto = TCP }

-- `udp host container` — publish a UDP port, machine side first. Note that the
-- `Expose` firewall rules are TCP-only, so a UDP port stays closed at nftables.
udp : Int -> Int -> Port
udp host container = Port { host = host, container = container, proto = UDP }

protoSuffix : Proto -> String
protoSuffix proto =
  case proto of
    TCP -> "tcp"
    UDP -> "udp"

publishPortLine : Port -> String
publishPortLine p =
  case p of
    Port spec ->
      "PublishPort=${String.fromInt spec.host}:${String.fromInt spec.container}/${protoSuffix spec.proto}"

-- One environment variable for the container — an `Environment=name=value` line
-- in the unit file, which golem writes at mode 0600 so only root can read it.
-- A `Secretspec.get` value is allowed here and ships sealed in the manifest;
-- it is plaintext in the unit file once golem has written it.
type EnvVar = EnvVar { name : String, value : String }

-- `env name value` — one environment variable for the container.
env : String -> String -> EnvVar
env name value = EnvVar { name = name, value = value }

needsQuoting : String -> Bool
needsQuoting value =
  String.contains " " value
    || String.contains "\t" value
    || String.contains "\"" value
    || String.contains "'" value
    || String.contains "\\" value

quoted : String -> String
quoted value =
  "\"" ++ String.replace "\"" "\\\"" (String.replace "\\" "\\\\" value) ++ "\""

quotedIfNeeded : String -> String
quotedIfNeeded value =
  if String.isSecret value then
    quoted value
  else if needsQuoting value then
    quoted value
  else
    value

environmentLine : EnvVar -> String
environmentLine e =
  case e of
    EnvVar spec -> "Environment=${spec.name}=${quotedIfNeeded spec.value}"

type Label = Label { name : String, value : String }

label : String -> String -> Label
label name value = Label { name = name, value = value }

labelLine : Label -> String
labelLine l =
  case l of
    Label spec -> "Label=${spec.name}=${quotedIfNeeded spec.value}"

type Network
  = ManagedNetwork String
  | ExistingNetwork String

networkLine : Network -> String
networkLine n =
  case n of
    ManagedNetwork name -> "Network=${name}.network"
    ExistingNetwork name -> "Network=${name}"

type NetworkUnit = NetworkUnit { name : String, driver : String }

networkUnit : String -> NetworkUnit
networkUnit name = NetworkUnit { name = name, driver = "bridge" }

derivedNetworkUnits : List Network -> List NetworkUnit
derivedNetworkUnits networks =
  List.concatMap derivedNetworkUnit networks

derivedNetworkUnit : Network -> List NetworkUnit
derivedNetworkUnit n =
  case n of
    ManagedNetwork name -> [ networkUnit name ]
    ExistingNetwork _ -> []

networkUnitContents : NetworkUnit -> String
networkUnitContents u =
  case u of
    NetworkUnit spec ->
      String.join "\n"
        [ "[Network]"
        , "NetworkName=${spec.name}"
        , "Driver=${spec.driver}"
        ]

networkUnitGlyphs : NetworkUnit -> List Glyph
networkUnitGlyphs u =
  case u of
    NetworkUnit spec ->
      [ aptPackage { name = "aardvark-dns" }
      , file
          { path = "/etc/containers/systemd/${spec.name}.network"
          , contents = networkUnitContents u
          , mode = "0644"
          }
      ]

-- The unit's `Restart=` value, as the three systemd words golem writes:
-- `always`, `on-failure`, `no`. Constructors rather than a string, so a typo is
-- a compile error instead of a unit systemd refuses at load.
type Restart = Always | OnFailure | No

restartValue : Restart -> String
restartValue r =
  case r of
    Always -> "always"
    OnFailure -> "on-failure"
    No -> "no"

-- Whether the container may write to a mount. `ReadOnly` appends `:ro` to the
-- `Volume=` line; `ReadWrite` appends nothing, which is podman's default.
type Access = ReadWrite | ReadOnly

-- SELinux relabeling for a mount: `Shared` appends `:z` (the label is shared
-- with other containers), `Private` appends `:Z` (this container only),
-- `NoRelabel` appends nothing and leaves the host's labels alone.
type Relabel = NoRelabel | Shared | Private

accessSuffix : Access -> String
accessSuffix a =
  case a of
    ReadWrite -> ""
    ReadOnly -> ":ro"

relabelSuffix : Relabel -> String
relabelSuffix r =
  case r of
    NoRelabel -> ""
    Shared -> ":z"
    Private -> ":Z"

-- Where a container's data comes from: a named podman volume (`FromVolume`) or
-- a path on the host (`FromHost`). Only `FromHost` emits a glyph of its own —
-- the `directory` its bind-mount source needs before the unit starts.
type Mount
  = FromVolume { volume : String, at : String, access : Access, relabel : Relabel }
  | FromHost { source : String, at : String, access : Access, relabel : Relabel }

-- `fromVolume volume at access relabel` — mount the named volume at the
-- container path `at`. The matching `.volume` unit is written for you; see
-- `derivedVolumeUnits`.
fromVolume : String -> String -> Access -> Relabel -> Mount
fromVolume volume at access relabel =
  FromVolume { volume = volume, at = at, access = access, relabel = relabel }

-- `fromHost source at access relabel` — bind-mount the host path `source` at
-- the container path `at`. `source` is created as a `0755` directory, so the
-- mount never conjures an empty one at start.
fromHost : String -> String -> Access -> Relabel -> Mount
fromHost source at access relabel =
  FromHost { source = source, at = at, access = access, relabel = relabel }

volumeLine : Mount -> String
volumeLine m =
  case m of
    FromVolume spec ->
      "Volume=${spec.volume}.volume:${spec.at}${relabelSuffix spec.relabel}${accessSuffix spec.access}"
    FromHost spec ->
      "Volume=${spec.source}:${spec.at}${relabelSuffix spec.relabel}${accessSuffix spec.access}"

hostSourceGlyphs : Mount -> List Glyph
hostSourceGlyphs m =
  case m of
    FromVolume _ -> []
    FromHost spec -> [ directory { path = spec.source, mode = "0755" } ]

-- A `.volume` quadlet unit — the file that declares a named podman volume, so
-- the volume exists without anyone running `podman volume create`.
type VolumeUnit = VolumeUnit { name : String, driver : String }

-- `volumeUnit name` — a volume unit on podman's `local` driver, the only driver
-- this library writes.
volumeUnit : String -> VolumeUnit
volumeUnit name = VolumeUnit { name = name, driver = "local" }

-- The volume units a mount list implies: one per `FromVolume`, none for a
-- `FromHost`. `workloadUnit` calls this, so declaring a volume mount is all it
-- takes to get its unit written.
derivedVolumeUnits : List Mount -> List VolumeUnit
derivedVolumeUnits mounts =
  List.concatMap derivedVolumeUnit mounts

derivedVolumeUnit : Mount -> List VolumeUnit
derivedVolumeUnit m =
  case m of
    FromVolume spec -> [ volumeUnit spec.volume ]
    FromHost _ -> []

volumeUnitContents : VolumeUnit -> String
volumeUnitContents v =
  case v of
    VolumeUnit spec ->
      String.join "\n"
        [ "[Volume]"
        , "Driver=${spec.driver}"
        ]

-- A volume unit as glyphs: the one `/etc/containers/systemd/<name>.volume`
-- file, which podman's quadlet generator turns into a systemd unit.
volumeUnitGlyphs : VolumeUnit -> List Glyph
volumeUnitGlyphs v =
  case v of
    VolumeUnit spec ->
      [ file
          { path = "/etc/containers/systemd/${spec.name}.volume"
          , contents = volumeUnitContents v
          , mode = "0644"
          }
      ]

-- A `.container` quadlet unit, one field per line of the file it becomes. This
-- is the systemd-shaped layer: a `Workload` lowers to it through `workloadUnit`,
-- and `containerUnitGlyphs` writes it out.
type ContainerUnit = ContainerUnit
  { name         : String
  , image        : Image
  , exec         : Maybe String
  , publishPorts : List Port
  , networks     : List Network
  , networkUnits : List NetworkUnit
  , mounts       : List Mount
  , volumeUnits  : List VolumeUnit
  , environment  : List EnvVar
  , labels       : List Label
  , restart      : Restart
  , wantedBy     : List String
  }

execLines : Maybe String -> List String
execLines exec =
  case exec of
    Nothing -> []
    Just command -> [ "Exec=${command}" ]

containerUnitContents : ContainerUnit -> String
containerUnitContents u =
  case u of
    ContainerUnit spec ->
      String.join "\n"
        (List.concat
          [ [ "[Unit]"
            , "Description=Golem workload: ${spec.name}"
            , ""
            , "[Container]"
            , "Image=${imageLine spec.image}"
            , "ContainerName=${spec.name}"
            ]
          , execLines spec.exec
          , List.map publishPortLine spec.publishPorts
          , List.map networkLine spec.networks
          , List.map volumeLine spec.mounts
          , List.map environmentLine spec.environment
          , List.map labelLine spec.labels
          , [ ""
            , "[Service]"
            , "Restart=${restartValue spec.restart}"
            , ""
            , "[Install]"
            , "WantedBy=${String.join " " spec.wantedBy}"
            ]
          ])

-- A container unit as glyphs, in apply order: podman installed, the host
-- directories its bind mounts need, its volume units' files, the
-- `<name>.container` file, then the `<name>.service` systemd glyph that starts
-- it.
containerUnitGlyphs : ContainerUnit -> List Glyph
containerUnitGlyphs u =
  case u of
    ContainerUnit spec ->
      List.concat
        [ [ aptPackage { name = "podman" } ]
        , List.concatMap hostSourceGlyphs spec.mounts
        , List.concatMap networkUnitGlyphs spec.networkUnits
        , List.concatMap volumeUnitGlyphs spec.volumeUnits
        , [ file
              { path = "/etc/containers/systemd/${spec.name}.container"
              , contents = containerUnitContents u
              , mode = "0600"
              }
          , systemdService { unit = "${spec.name}.service" }
          ]
        ]

-- How far a workload's published ports reach, and so which firewall glyphs it
-- emits under `/etc/nftables.d/`. `Unexposed` writes none — the port is
-- reachable only from the host. `Internal` writes one complete `<name>-<port>`
-- drop-in per port, accepting from `Fleet.internalNetwork` alone. `Public`
-- writes one complete `public-<name>-<port>` drop-in per port, accepting from
-- anywhere (ADR 0041 — one drop-in file per glyph, never a shared file). Any
-- workload that writes a drop-in also carries `Nftables.nftablesBase`, so the
-- table, its entrypoint, and the unit that loads them exist; identical
-- contributions from sibling workloads collapse by content id (ADR 0034).
-- Rules are TCP-only, and a scroll that writes them wants
-- `notifies = [ "golem-nftables.service" ]` so the change is loaded (ADR 0036).
type Expose = Unexposed | Internal | Public

-- What to run, stated without systemd: an image, its ports, volumes, and
-- environment, plus how far it is exposed. The authoring surface of this
-- library — `workloadGlyphs` is the only other thing a scroll needs.
type Workload = Workload
  { name     : String
  , image    : Image
  , env      : List EnvVar
  , labels   : List Label
  , ports    : List Port
  , networks : List Network
  , volumes  : List Mount
  , restart  : Restart
  , expose   : Expose
  }

-- The container unit a workload lowers to: volume units derived from its
-- mounts, no `Exec=` (the image's own entrypoint runs), and `WantedBy` both
-- `multi-user.target` and `default.target` so it starts on boot.
workloadUnit : Workload -> ContainerUnit
workloadUnit w =
  case w of
    Workload spec ->
      ContainerUnit
        { name = spec.name
        , image = spec.image
        , exec = Nothing
        , publishPorts = spec.ports
        , networks = spec.networks
        , networkUnits = derivedNetworkUnits spec.networks
        , mounts = spec.volumes
        , volumeUnits = derivedVolumeUnits spec.volumes
        , environment = spec.env
        , labels = spec.labels
        , restart = spec.restart
        , wantedBy = [ "multi-user.target", "default.target" ]
        }

internalDropInName : String -> Port -> String
internalDropInName name p =
  case p of
    Port spec -> "${name}-${String.fromInt spec.host}"

publicDropInName : String -> Port -> String
publicDropInName name p =
  case p of
    Port spec -> "public-${name}-${String.fromInt spec.host}"

internalAcceptRule : String -> Port -> String
internalAcceptRule name p =
  case p of
    Port spec ->
      "tcp dport ${String.fromInt spec.host} ip saddr ${internalNetwork} accept comment \"${name}\""

publicAcceptRule : String -> Port -> String
publicAcceptRule name p =
  case p of
    Port spec ->
      "tcp dport ${String.fromInt spec.host} accept comment \"${name}\""

portFirewallGlyphs : String -> Expose -> Port -> List Glyph
portFirewallGlyphs name expose p =
  case expose of
    Unexposed -> []
    Internal ->
      [ nftablesDropIn (internalDropInName name p) [ internalAcceptRule name p ] ]
    Public ->
      [ nftablesDropIn (publicDropInName name p) [ publicAcceptRule name p ] ]

-- Prefix the base ahead of the drop-ins it makes loadable, or emit nothing at
-- all. Order is not cosmetic: `/etc/nftables.d` is a glyph in `nftablesBase`,
-- and source order is enact order (ADR 0031), so a drop-in placed first would be
-- written into a directory that does not exist yet. An `Unexposed` workload
-- contributes no drop-in and so must not drag in the package, the table, and the
-- service either — hence the empty case.
withNftablesBase : List Glyph -> List Glyph
withNftablesBase dropIns =
  case dropIns of
    [] -> []
    _ -> List.concat [ nftablesBase, dropIns ]

firewallGlyphs : Workload -> List Glyph
firewallGlyphs w =
  case w of
    Workload spec ->
      withNftablesBase (List.concatMap (portFirewallGlyphs spec.name spec.expose) spec.ports)

-- A whole workload as glyphs: its container unit (and everything that unit
-- needs) followed by the firewall files its `expose` calls for. The one call a
-- scroll makes — `glyphs = workloadGlyphs (Workload { … })`.
workloadGlyphs : Workload -> List Glyph
workloadGlyphs w =
  List.concat
    [ containerUnitGlyphs (workloadUnit w)
    , firewallGlyphs w
    ]

-- The shipped, strongly-typed Podman-Quadlet library (ADR 0023 layer b):
-- Debian + systemd + Podman specific, and lowering entirely to the four glyphs.
-- It models the two quadlet unit kinds golem actually writes — a `.container`
-- and the separate `.volume` unit it references by a mount line — so the types
-- mirror the files on disk rather than an invented middle layer.
--
-- `Mount` is a sum because a named-volume mount and a host-path mount are
-- genuinely different: `FromVolume` names a `.volume` unit and emits no
-- directory; `FromHost` names a host path and emits a `directory` glyph source
-- (ADR 0019) so the bind-mount source exists before the unit starts.
--
-- Three ways to name an image. `image registry name tag` and `imageAt registry
-- name digest` take the parts explicitly. `imageRef` takes one Docker reference
-- string (`"ghcr.io/dull/golem:v1"`) and splits it structurally — the ADR 0023
-- §1 single-string constructor, unblocked now that `String.split` exists
-- (ADR 0025).
--
-- Lowering: a `Workload` becomes a `ContainerUnit` plus the `VolumeUnit`s its
-- `FromVolume` mounts reference (`workloadUnit`/`derivedVolumeUnits`), and those
-- lower to glyphs (`containerUnitGlyphs`/`volumeUnitGlyphs`).
module Quadlet exposing
  ( Ref(..)
  , Image(..)
  , image
  , imageAt
  , imageRef
  , Proto(..)
  , Port(..)
  , tcp
  , udp
  , EnvVar(..)
  , env
  , Restart(..)
  , Access(..)
  , Relabel(..)
  , Mount(..)
  , fromVolume
  , fromHost
  , VolumeUnit(..)
  , volumeUnit
  , ContainerUnit(..)
  , Expose(..)
  , Workload(..)
  , derivedVolumeUnits
  , volumeUnitGlyphs
  , containerUnitGlyphs
  , workloadUnit
  , workloadGlyphs
  )

import Fleet exposing (internalNetwork)

type Ref
  = Tag String
  | Digest String

type Image = Image
  { registry : String
  , name     : String
  , ref      : Ref
  }

image : String -> String -> String -> Image
image registry name tag =
  Image { registry = registry, name = name, ref = Tag tag }

imageAt : String -> String -> String -> Image
imageAt registry name digest =
  Image { registry = registry, name = name, ref = Digest digest }

-- Renders the `Image=` line value from an `Image` — `registry/name:tag` or
-- `registry/name@digest`. Named `imageRef` until the single-string parser took
-- that name (Emet has no overloading).
imageLine : Image -> String
imageLine img =
  case img of
    Image spec ->
      case spec.ref of
        Tag t -> "${spec.registry}/${spec.name}:${t}"
        Digest d -> "${spec.registry}/${spec.name}@${d}"

defaultRegistry : String
defaultRegistry = "docker.io"

looksLikeRegistry : String -> Bool
looksLikeRegistry segment =
  String.contains "." segment
    || String.contains ":" segment
    || segment == "localhost"

absent : Int
absent = 0 - 1

firstIndex : String -> String -> Int
firstIndex needle haystack =
  List.foldl (\i seen -> if seen < 0 then i else seen) absent (String.indexes needle haystack)

lastIndex : String -> String -> Int
lastIndex needle haystack =
  List.foldl (\i _ -> i) absent (String.indexes needle haystack)

splitRegistry : String -> { registry : String, path : String }
splitRegistry reference =
  let
    slash = firstIndex "/" reference
    head = String.left slash reference
    rest = String.dropLeft (slash + 1) reference
    hasRegistry = slash >= 0 && looksLikeRegistry head
  in
    if hasRegistry then
      { registry = head, path = rest }
    else
      { registry = defaultRegistry, path = reference }

splitTag : String -> { name : String, tag : String }
splitTag path =
  let
    lastSlash = lastIndex "/" path
    colon = lastIndex ":" path
    hasTag = colon > lastSlash
  in
    if hasTag then
      { name = String.left colon path, tag = String.dropLeft (colon + 1) path }
    else
      { name = path, tag = "latest" }

-- The digest arm of `imageRef`: the text before the `@` split into registry and
-- name, the text after taken as the digest verbatim. Split out as its own
-- function because its `let … in` cannot nest inside a `case` arm, so the
-- digest-vs-tag choice in `imageRef` is a top-level `if`, not a `case` with
-- `let`s in its arms (docs/TODO.md, A. Emet language backlog).
imageRefDigest : String -> String -> Image
imageRefDigest beforeDigest digest =
  let
    parts = splitRegistry beforeDigest
  in
    Image { registry = parts.registry, name = parts.path, ref = Digest digest }

-- The tag arm of `imageRef` (no `@` in the reference): split off any registry,
-- then read a `:tag` after the last `/`, defaulting to `latest`. A sibling of
-- `imageRefDigest` for the same `case`-arm `let` reason noted there.
imageRefTagged : String -> Image
imageRefTagged reference =
  let
    parts = splitRegistry reference
    tagged = splitTag parts.path
  in
    Image { registry = parts.registry, name = tagged.name, ref = Tag tagged.tag }

-- Parses one Docker reference string into an `Image`, structurally and without
-- touching the network. The rules:
--   * a digest is everything after the first `@`;
--   * the leading `/`-segment is a registry only if it looks like one — it
--     contains `.` or `:`, or equals `localhost` — otherwise there is no
--     explicit registry and `registry` defaults to `docker.io`;
--   * a `:` after the last `/` is the tag; with none, the tag defaults to
--     `latest`.
-- Total: it never validates against a registry and never fails. Odd input
-- degrades to these defaults rather than crashing — `imageRef "registry"` is
-- `docker.io/registry:latest`, not an error.
imageRef : String -> Image
imageRef reference =
  let
    at = firstIndex "@" reference
  in
    if at >= 0 then
      imageRefDigest (String.left at reference) (String.dropLeft (at + 1) reference)
    else
      imageRefTagged reference

type Proto = TCP | UDP

type Port = Port { host : Int, container : Int, proto : Proto }

tcp : Int -> Int -> Port
tcp host container = Port { host = host, container = container, proto = TCP }

udp : Int -> Int -> Port
udp host container = Port { host = host, container = container, proto = UDP }

protoSuffix : Proto -> String
protoSuffix proto =
  case proto of
    TCP -> "tcp"
    UDP -> "udp"

publishPortLine : Port -> String
publishPortLine p =
  case p of
    Port spec ->
      "PublishPort=${String.fromInt spec.host}:${String.fromInt spec.container}/${protoSuffix spec.proto}"

type EnvVar = EnvVar { name : String, value : String }

env : String -> String -> EnvVar
env name value = EnvVar { name = name, value = value }

environmentLine : EnvVar -> String
environmentLine e =
  case e of
    EnvVar spec -> "Environment=${spec.name}=${spec.value}"

type Restart = Always | OnFailure | No

restartValue : Restart -> String
restartValue r =
  case r of
    Always -> "always"
    OnFailure -> "on-failure"
    No -> "no"

type Access = ReadWrite | ReadOnly

type Relabel = NoRelabel | Shared | Private

accessSuffix : Access -> String
accessSuffix a =
  case a of
    ReadWrite -> ""
    ReadOnly -> ":ro"

relabelSuffix : Relabel -> String
relabelSuffix r =
  case r of
    NoRelabel -> ""
    Shared -> ":z"
    Private -> ":Z"

type Mount
  = FromVolume { volume : String, at : String, access : Access, relabel : Relabel }
  | FromHost { source : String, at : String, access : Access, relabel : Relabel }

fromVolume : String -> String -> Access -> Relabel -> Mount
fromVolume volume at access relabel =
  FromVolume { volume = volume, at = at, access = access, relabel = relabel }

fromHost : String -> String -> Access -> Relabel -> Mount
fromHost source at access relabel =
  FromHost { source = source, at = at, access = access, relabel = relabel }

volumeLine : Mount -> String
volumeLine m =
  case m of
    FromVolume spec ->
      "Volume=${spec.volume}.volume:${spec.at}${relabelSuffix spec.relabel}${accessSuffix spec.access}"
    FromHost spec ->
      "Volume=${spec.source}:${spec.at}${relabelSuffix spec.relabel}${accessSuffix spec.access}"

hostSourceGlyphs : Mount -> List Glyph
hostSourceGlyphs m =
  case m of
    FromVolume _ -> []
    FromHost spec -> [ directory { path = spec.source, mode = "0755" } ]

type VolumeUnit = VolumeUnit { name : String, driver : String }

volumeUnit : String -> VolumeUnit
volumeUnit name = VolumeUnit { name = name, driver = "local" }

derivedVolumeUnits : List Mount -> List VolumeUnit
derivedVolumeUnits mounts =
  List.concatMap derivedVolumeUnit mounts

derivedVolumeUnit : Mount -> List VolumeUnit
derivedVolumeUnit m =
  case m of
    FromVolume spec -> [ volumeUnit spec.volume ]
    FromHost _ -> []

volumeUnitContents : VolumeUnit -> String
volumeUnitContents v =
  case v of
    VolumeUnit spec ->
      String.join "\n"
        [ "[Volume]"
        , "Driver=${spec.driver}"
        ]

volumeUnitGlyphs : VolumeUnit -> List Glyph
volumeUnitGlyphs v =
  case v of
    VolumeUnit spec ->
      [ file
          { path = "/etc/containers/systemd/${spec.name}.volume"
          , contents = volumeUnitContents v
          , mode = "0644"
          }
      ]

type ContainerUnit = ContainerUnit
  { name         : String
  , image        : Image
  , exec         : Maybe String
  , publishPorts : List Port
  , mounts       : List Mount
  , volumeUnits  : List VolumeUnit
  , environment  : List EnvVar
  , restart      : Restart
  , wantedBy     : List String
  }

execLines : Maybe String -> List String
execLines exec =
  case exec of
    Nothing -> []
    Just command -> [ "Exec=${command}" ]

containerUnitContents : ContainerUnit -> String
containerUnitContents u =
  case u of
    ContainerUnit spec ->
      String.join "\n"
        (List.concat
          [ [ "[Unit]"
            , "Description=Golem workload: ${spec.name}"
            , ""
            , "[Container]"
            , "Image=${imageLine spec.image}"
            , "ContainerName=${spec.name}"
            ]
          , execLines spec.exec
          , List.map publishPortLine spec.publishPorts
          , List.map volumeLine spec.mounts
          , List.map environmentLine spec.environment
          , [ ""
            , "[Service]"
            , "Restart=${restartValue spec.restart}"
            , ""
            , "[Install]"
            , "WantedBy=${String.join " " spec.wantedBy}"
            ]
          ])

containerUnitGlyphs : ContainerUnit -> List Glyph
containerUnitGlyphs u =
  case u of
    ContainerUnit spec ->
      List.concat
        [ [ aptPackage { name = "podman" } ]
        , List.concatMap hostSourceGlyphs spec.mounts
        , List.concatMap volumeUnitGlyphs spec.volumeUnits
        , [ file
              { path = "/etc/containers/systemd/${spec.name}.container"
              , contents = containerUnitContents u
              , mode = "0644"
              }
          , systemdService { unit = "${spec.name}.service" }
          ]
        ]

type Expose = Unexposed | Internal | Public

type Workload = Workload
  { name    : String
  , image   : Image
  , env     : List EnvVar
  , ports   : List Port
  , volumes : List Mount
  , restart : Restart
  , expose  : Expose
  }

workloadUnit : Workload -> ContainerUnit
workloadUnit w =
  case w of
    Workload spec ->
      ContainerUnit
        { name = spec.name
        , image = spec.image
        , exec = Nothing
        , publishPorts = spec.ports
        , mounts = spec.volumes
        , volumeUnits = derivedVolumeUnits spec.volumes
        , environment = spec.env
        , restart = spec.restart
        , wantedBy = [ "multi-user.target", "default.target" ]
        }

firewallPath : String -> Port -> String
firewallPath name p =
  case p of
    Port spec -> "/etc/nftables.d/${name}-${String.fromInt spec.host}.nft"

internalRule : String -> Port -> String
internalRule name p =
  case p of
    Port spec ->
      String.join "\n"
        [ "table inet filter {"
        , "  chain input {"
        , "    tcp dport ${String.fromInt spec.host} ip saddr ${internalNetwork} accept comment \"${name}\""
        , "  }"
        , "}"
        ]

publicRule : String -> Port -> String
publicRule name p =
  case p of
    Port spec ->
      String.join "\n"
        [ "table inet filter {"
        , "  chain input {"
        , "    tcp dport ${String.fromInt spec.host} accept comment \"${name}\""
        , "  }"
        , "}"
        ]

ingressLine : String -> Port -> String
ingressLine name p =
  case p of
    Port spec -> "tcp dport ${String.fromInt spec.host} accept comment \"ingress ${name}\""

portFirewallGlyphs : String -> Expose -> Port -> List Glyph
portFirewallGlyphs name expose p =
  case expose of
    Unexposed -> []
    Internal ->
      [ file { path = firewallPath name p, contents = internalRule name p, mode = "0644" } ]
    Public ->
      [ file { path = firewallPath name p, contents = publicRule name p, mode = "0644" }
      , lineInFile { path = "/etc/nftables.d/ingress.nft", line = ingressLine name p }
      ]

firewallGlyphs : Workload -> List Glyph
firewallGlyphs w =
  case w of
    Workload spec ->
      List.concatMap (portFirewallGlyphs spec.name spec.expose) spec.ports

workloadGlyphs : Workload -> List Glyph
workloadGlyphs w =
  List.concat
    [ containerUnitGlyphs (workloadUnit w)
    , firewallGlyphs w
    ]

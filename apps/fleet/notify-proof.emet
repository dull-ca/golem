module Main exposing (..)

helloUnit : Filesystem
helloUnit =
  file
    { path = "/etc/systemd/system/golem-notify.service"
    , contents = "[Unit]\nDescription=Golem notify proof\n\n[Service]\nType=simple\nExecStart=/bin/sh -c 'while true; do sleep 3600; done'\nExecReload=/bin/true\n\n[Install]\nWantedBy=multi-user.target\n"
    , mode = "0644"
    }

service : Scroll
service =
  scroll
    { name = "service"
    , glyphs = [ helloUnit, systemdService { unit = "golem-notify.service" } ]
    }

config : Scroll
config =
  scroll
    { name = "config"
    , notifies = [ "golem-notify.service" ]
    , glyphs =
        [ file
            { path = "/etc/golem-notify/notify.conf"
            , contents = "greeting = hello\n"
            , mode = "0644"
            }
        ]
    }

scaly : Scroll
scaly =
  scroll { name = "scaly", groups = [ service, config ] }

main : List Scroll
main = [ scaly ]
